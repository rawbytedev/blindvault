{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false,
        "noEmit": false,
        "outDir": "./dist",
        "rootDir": "./src",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": false,
        "sourceMap": true,
        "types": [
            "node",
            "vite/client"
        ]
    },
    "include": [
        "src/index.ts",
        "src/bls_blind.ts"
    ],
    "exclude": [
        "src/**/*.test.ts",
        "src/run.ts",
        "src/main.tsx"
    ]
}