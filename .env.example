# BlindVault environment example
# Copy this file to .env and replace every placeholder value before running locally.

# Core runtime
BLINDVAULT_MODE=your-mode
ACTIVE_EPOCH=YYYY-MM
SUPPORTED_EPOCHS=YYYY-MM,YYYY-MM
DST=your-dst-string
LISTEN_ADDR=address:your-port

# Secret material
## make sure to choose either a seed_file or master_seed from env
BLINDVAULT_MASTER_SEED_HEX=<32-byte-hex-seed>
BLINDVAULT_SEED_FILE=/path/to/your/seed.txt
AUTH_SECRET=<32-plus-character-secret>
JWT_ISSUER=https://your-issuer.example.com
JWT_AUDIENCE=your-audience

# Redis configuration
REDIS_ADDR=redis-host:redis-port
REDIS_PASSWORD=your-redis-password
REDIS_DB=database_number
REDIS_EXPIRATION=expiration_in_seconds
REVOCATION_REDIS_ADDR=revocation-redis-host:redis-port
REVOCATION_REDIS_PASSWORD=your-revocation-redis-password
REVOCATION_REDIS_DB=database_number

# Feature toggles and operational limits
USE_MEMORY_STORE=false # true/false
USE_DEMO=false # true/false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_BURST=20
MAX_CLIENTS=100000
