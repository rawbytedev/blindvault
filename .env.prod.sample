BLINDVAULT_MODE=production
# Master seed: prefer BLINDVAULT_SEED_FILE over inline hex in prod.
# BLINDVAULT_SEED_FILE=/run/secrets/blindvault_master_seed
# BLINDVAULT_MASTER_SEED_HEX=<64 hex chars>

ACTIVE_EPOCH=2026-01
SUPPORTED_EPOCHS=2026-01

AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-chars
JWT_ISSUER=blindvault
JWT_AUDIENCE=blindvault-api

REDIS_ADDR=redis:6379
REDIS_PASSWORD=<redis password>
REDIS_DB=0

REVOCATION_REDIS_ADDR=redis:6379
REVOCATION_REDIS_DB=1
REDIS_EXPIRATION=2592000

USE_MEMORY_STORE=false
USE_DEMO=false

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_BURST=20
MAX_CLIENTS=1000
