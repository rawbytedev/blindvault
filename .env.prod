# Production .env sample — do NOT commit real secrets
# Prefer BLINDVAULT_SEED_FILE pointing to a protected file in production
BLINDVAULT_MODE=production
#BLINDVAULT_MASTER_SEED_HEX=<generate with: openssl rand -hex 32>
# Create this file first: openssl rand -hex 32 > /run/secrets/blindvault_master_seed
BLINDVAULT_SEED_FILE=/run/secrets/blindvault_master_seed
AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-chars
JWT_ISSUER=https://auth.example.com/
JWT_AUDIENCE=blindvault
LISTEN_ADDR=:8080
ACTIVE_EPOCH=2026-01
SUPPORTED_EPOCHS=2026-01,2026-02
DST=BCIS-V1-PROD
USE_MEMORY_STORE=false
USE_DEMO=false
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_EXPIRATION=2592000
REDIS_DB=0
RATE_LIMIT_BURST=100
RATE_LIMIT_REQUESTS=1000
MAX_CLIENTS=1000
